# Takumi Guard token (set in GitHub Secrets as TAKUMI_GUARD_TOKEN)
# Get your token from https://shisho.dev/docs/ja/t/guard/quickstart/
TAKUMI_GUARD_TOKEN=tg_anon_your_token_here

# Database
OCMS_DATABASE_URL=postgresql+psycopg://ocms:ocms_local@localhost:5432/ocms

# AWS
OCMS_AWS_REGION=us-east-1

# HuggingFace (store in Secrets Manager in production)
HF_TOKEN=hf_your_token_here
